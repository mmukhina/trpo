<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>997</width>
    <height>500</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Синтаксический анализатор</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    /* Global background */
    QMainWindow, QWidget#centralwidget {
        background-color: #e8ecf1;
    }
    
    /* Input frame */
    QFrame#inputFrame {
        background-color: #ffffff;
        border: 1px solid #d0d0d0;
        border-radius: 8px;
    }
    
    /* Text edit styling */
    QTextEdit {
        border: 1px solid #d0d0d0;
        border-radius: 6px;
        padding: 6px;
        font-size: 12px;
        background-color: #fafbfc;
    }
    QTextEdit:focus {
        border-color: #3498db;
        background-color: #ffffff;
    }
    
    /* Button styling */
    QPushButton {
        border-radius: 5px;
        padding: 4px 10px;
    }
    
    QPushButton#btn_search {
        background-color: #3498db;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 500;
        padding: 5px 14px;
    }
    QPushButton#btn_search:hover {
        background-color: #2980b9;
    }
    QPushButton#btn_search:pressed {
        background-color: #1f618d;
    }
    QPushButton#btn_search:disabled {
        background-color: #bdc3c7;
    }
    
    QPushButton#btn_upload {
        background-color: #ecf0f1;
        color: #2c3e50;
        border: 1px solid #bdc3c7;
        border-radius: 6px;
        font-size: 12px;
        padding: 5px 14px;
    }
    QPushButton#btn_upload:hover {
        background-color: #dfe6e9;
    }
    QPushButton#btn_upload:pressed {
        background-color: #bdc3c7;
    }
    
    QPushButton#btn_download {
        background-color: #27ae60;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-size: 12px;
        padding: 5px 14px;
    }
    QPushButton#btn_download:disabled {
        background-color: #bdc3c7;
        color: #95a5a6;
    }
    QPushButton#btn_download:hover:enabled {
        background-color: #219a52;
    }
    
    /* Filter frame */
    QFrame#filterFrame {
        background-color: #ffffff;
        border: 1px solid #d0d0d0;
        border-radius: 8px;
    }
    
    QLabel#filterLabel {
        color: #2c3e50;
        font-size: 12px;
        font-weight: bold;
    }
    
    /* Checkbox styling */
    QCheckBox {
        spacing: 6px;
        font-size: 11px;
        color: #2c3e50;
        background-color: transparent;
    }
    QCheckBox::indicator {
        width: 14px;
        height: 14px;
        border-radius: 3px;
        border: 1px solid #bdc3c7;
        background-color: #ffffff;
    }
    QCheckBox::indicator:checked {
        background-color: #3498db;
        border-color: #3498db;
    }
    QCheckBox::indicator:hover {
        border-color: #3498db;
    }
    
    QCheckBox#c_all {
        font-weight: bold;
        color: #3498db;
    }
    QCheckBox#c_all::indicator {
        border-color: #3498db;
    }
    
    /* Tab widget styling */
    QTabWidget::pane {
        background-color: #ffffff;
        border: 1px solid #d0d0d0;
        border-radius: 8px;
    }
    QTabBar::tab {
        background-color: #ecf0f1;
        padding: 6px 16px;
        margin-right: 2px;
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
        font-size: 12px;
        font-weight: 500;
        color: #2c3e50;
    }
    QTabBar::tab:selected {
        background-color: #ffffff;
        color: #3498db;
        border-bottom: 2px solid #3498db;
    }
    QTabBar::tab:hover:!selected {
        background-color: #dfe6e9;
    }
    
    /* Tree widget styling */
    QTreeWidget {
        background-color: #ffffff;
        color: #495057;
        border: none;
        font-size: 12px;
        outline: 0;
    }
    QTreeWidget::item {
        padding: 5px;
        border-bottom: 1px solid #ecf0f1;
        background-color: #ffffff;
    }
    QTreeWidget::item:hover {
        background-color: #f0f4f8;
    }
    QTreeWidget::item:selected {
        color: #495057;
    }
    QHeaderView::section {
        background-color: #f8fafc;
        padding: 6px;
        border: none;
        border-bottom: 1px solid #d0d0d0;
        font-weight: 500;
        font-size: 12px;
        color: #2c3e50;
    }
    
    /* Statistics container */
    QWidget#statisticsContainer {
        background-color: #ffffff;
        min-height: 520px;
        max-height: 520px;
    }
    
    /* Statistics buttons row */
    QWidget#statButtonsWidget {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        padding: 8px;
    }
    
    QPushButton#statButton {
        background-color: #e9ecef;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: bold;
        color: #495057;
        min-width: 100px;
    }
    QPushButton#statButton:hover {
        background-color: #dee2e6;
    }
    QPushButton#statButton[expanded=&quot;true&quot;] {
        background-color: #3498db;
        color: white;
        border-color: #3498db;
    }
    
    /* Expandable content area */
    QScrollArea#contentScrollArea {
        border: none;
        background-color: white;
    }
    QScrollArea#contentScrollArea QScrollBar:vertical {
        border: none;
        background: #f0f0f0;
        width: 8px;
        border-radius: 4px;
    }
    QScrollArea#contentScrollArea QScrollBar::handle:vertical {
        background: #c0c0c0;
        border-radius: 4px;
        min-height: 30px;
    }
    QScrollArea#contentScrollArea QScrollBar::handle:vertical:hover {
        background: #3498db;
    }
    
    QLabel#sentenceLabel {
        color: #2c3e50;
        font-size: 12px;
        padding: 6px 8px;
        background-color: #f8f9fa;
        border-radius: 4px;
        margin: 2px 0;
    }
    QLabel#sentenceLabel:hover {
        background-color: #e9ecef;
    }
    
    QLabel#noDataLabel {
        color: #6c757d;
        font-style: italic;
        padding: 20px;
        text-align: center;
    }
    
    QLabel#placeholderLabel {
        color: #6c757d;
        font-size: 14px;
        font-style: italic;
        padding: 40px;
        text-align: center;
    }
    
    /* Scrollbar styling */
    QScrollBar:vertical {
        border: none;
        background: #f0f0f0;
        width: 8px;
        border-radius: 4px;
        margin: 0px;
    }
    QScrollBar::handle:vertical {
        background: #c0c0c0;
        min-height: 30px;
        border-radius: 4px;
    }
    QScrollBar::handle:vertical:hover {
        background: #3498db;
    }
    QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
        height: 0px;
    }
    
    /* Status bar styling */
    QStatusBar {
        background-color: #2c3e50;
        color: #ffffff;
        padding: 3px 6px;
        font-size: 11px;
    }
   </string>
  </property>
