  <property name="styleSheet">
   <string notr="true">
/* Force light background - override dark mode */
QMainWindow, QWidget#centralwidget {
background-color: #e8ecf1;
}
/* Полное отключение индикатора фокуса для всех виджетов */
*:focus {
outline: none;
}
QWidget:focus {
outline: none;
}
/* Input frame */
QFrame#inputFrame {
background-color: #ffffff;
border: 1px solid #d0d0d0;
border-radius: 8px;
}
/* Text edit styling */
QTextEdit {
border: 1px solid #d0d0d0;
border-radius: 6px;
padding: 6px;
font-size: 12px;
background-color: #fafbfc;
color: #2c3e50;
}
QTextEdit:focus {
border-color: #3498db;
background-color: #ffffff;
color: #2c3e50;
outline: none;
}
/* Button styling */
QPushButton {
border-radius: 5px;
padding: 4px 10px;
}
QPushButton:focus {
outline: none;
}
QPushButton#btn_search {
background-color: #3498db;
color: #ffffff;
border: none;
border-radius: 6px;
font-size: 12px;
font-weight: 500;
padding: 5px 14px;
}
QPushButton#btn_search:hover {
background-color: #2980b9;
}
QPushButton#btn_search:pressed {
background-color: #1f618d;
}
QPushButton#btn_search:disabled {
background-color: #bdc3c7;
}
QPushButton#btn_upload {
background-color: #ecf0f1;
color: #2c3e50;
border: 1px solid #bdc3c7;
border-radius: 6px;
font-size: 12px;
padding: 5px 14px;
}
QPushButton#btn_upload:hover {
background-color: #dfe6e9;
}
QPushButton#btn_upload:pressed {
background-color: #bdc3c7;
}
QPushButton#btn_download {
background-color: #27ae60;
color: #ffffff;
border: none;
border-radius: 6px;
font-size: 12px;
padding: 5px 14px;
}
QPushButton#btn_download:disabled {
background-color: #bdc3c7;
}
QPushButton#btn_download:hover:enabled {
background-color: #219a52;
}
/* Filter frame */
QFrame#filterFrame {
background-color: #ffffff;
border: 1px solid #d0d0d0;
border-radius: 8px;
}
QLabel#filterLabel {
color: #2c3e50;
font-size: 12px;
font-weight: bold;
}
/* Checkbox styling - убираем рамку фокуса */
QCheckBox {
spacing: 6px;
font-size: 11px;
color: #2c3e50;
background-color: transparent;
outline: none;
}
QCheckBox:focus {
outline: none;
border: none;
}
QCheckBox::indicator {
width: 14px;
height: 14px;
border-radius: 3px;
border: 1px solid #bdc3c7;
background-color: #ffffff;
}
QCheckBox::indicator:checked {
background-color: #3498db;
border-color: #3498db;
}
QCheckBox::indicator:hover {
border-color: #3498db;
}
QCheckBox::indicator:focus {
border: 1px solid #3498db;
outline: none;
}
QCheckBox#c_all {
font-weight: bold;
color: #3498db;
}
QCheckBox#c_all::indicator {
border-color: #3498db;
}
/* Tab widget styling */
QTabWidget::pane {
background-color: #ffffff;
border: 1px solid #d0d0d0;
border-radius: 8px;
}
QTabBar::tab {
background-color: #ecf0f1;
padding: 8px 20px;
margin-right: 2px;
border-top-left-radius: 6px;
border-top-right-radius: 6px;
font-size: 12px;
font-weight: 500;
color: #2c3e50;
min-width: 120px;
}
QTabBar::tab:focus {
outline: none;
}
QTabBar::tab:selected {
background-color: #ffffff;
color: #3498db;
border-bottom: 2px solid #3498db;
}
QTabBar::tab:hover:!selected {
background-color: #ecf0f1;
}
/* Tree Widget Styling */
QTreeWidget {
background-color: #ffffff;
color: #495057;
border: none;
font-size: 12px;
outline: 0;
alternate-background-color: #f8f9fa;
selection-background-color: transparent;
selection-color: #495057;
}
/* Убраны все правила для QTreeWidget::branch, чтобы вернуть системные стрелки */
QTreeWidget::item {
padding: 8px;
border-bottom: 1px solid #ecf0f1;
color: #495057;
}
QTreeWidget::item:hover {
background-color: transparent;
}
QTreeWidget::item:selected {
background-color: transparent;
color: #495057;
}
QTreeWidget::item:selected:hover {
background-color: transparent;
}
QTreeWidget::item:focus {
outline: none;
background-color: transparent;
color: #495057;
}
/* Table Widget Styling */
QTableWidget {
background-color: #ffffff;
color: #495057;
border: none;
font-size: 12px;
outline: 0;
alternate-background-color: #f8f9fa;
selection-background-color: transparent;
selection-color: #495057;
}
QTableWidget::item {
padding: 8px;
border-bottom: 1px solid #ecf0f1;
color: #495057;
}
QTableWidget::item:hover {
background-color: transparent;
}
QTableWidget::item:selected {
background-color: transparent;
color: #495057;
}
/* Header Styling */
QHeaderView::section {
background-color: #f8fafc;
padding: 10px;
border: none;
border-bottom: 2px solid #3498db;
font-weight: bold;
font-size: 12px;
color: #2c3e50;
}
QHeaderView::section:hover {
background-color: #f8fafc;
}
QHeaderView::section:pressed {
background-color: #f8fafc;
}
QTableCornerButton::section {
background-color: #f8fafc;
border: none;
}
/* Statistics container */
QWidget#statisticsContainer {
background-color: #ffffff;
min-height: 520px;
max-height: 520px;
}
/* Statistics buttons row */
QWidget#statButtonsWidget {
background-color: #f8f9fa;
border-bottom: 1px solid #dee2e6;
padding: 8px;
}
QPushButton#statButton {
background-color: #e9ecef;
border: 1px solid #dee2e6;
border-radius: 6px;
padding: 8px 12px;
font-size: 12px;
font-weight: bold;
color: #495057;
min-width: 100px;
}
QPushButton#statButton:focus {
outline: none;
}
QPushButton#statButton:hover {
background-color: #dee2e6;
}
QPushButton#statButton[expanded=&quot;true&quot;] {
background-color: #3498db;
color: white;
border-color: #3498db;
}
/* Expandable content area */
QScrollArea#contentScrollArea {
border: none;
background-color: white;
}
QScrollArea#contentScrollArea QScrollBar:vertical {
border: none;
background: #f0f0f0;
width: 8px;
border-radius: 4px;
}
QScrollArea#contentScrollArea QScrollBar::handle:vertical {
background: #c0c0c0;
border-radius: 4px;
min-height: 30px;
}
QScrollArea#contentScrollArea QScrollBar::handle:vertical:hover {
background: #3498db;
}
QScrollArea#contentScrollArea QScrollBar::handle:vertical:pressed {
background: #2980b9;
}
QLabel#sentenceLabel {
color: #2c3e50;
font-size: 12px;
padding: 6px 8px;
background-color: #f8f9fa;
border-radius: 4px;
margin: 2px 0;
}
QLabel#sentenceLabel:hover {
background-color: #e9ecef;
}
QLabel#noDataLabel {
color: #6c757d;
font-style: italic;
padding: 20px;
text-align: center;
}
/* Placeholder styling */
QLabel#placeholderLabel, QLabel#wordFreqPlaceholderLabel {
color: #6c757d;
font-size: 14px;
font-style: italic;
padding: 40px;
text-align: center;
}
/* Scrollbar styling */
QScrollBar:vertical {
border: none;
background: #f0f0f0;
width: 8px;
border-radius: 4px;
margin: 0px;
}
QScrollBar::handle:vertical {
background: #c0c0c0;
min-height: 30px;
border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
background: #3498db;
}
QScrollBar::handle:vertical:pressed {
background: #2980b9;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
background: none;
}
QScrollBar:horizontal {
border: none;
background: #f0f0f0;
height: 8px;
border-radius: 4px;
margin: 0px;
}
QScrollBar::handle:horizontal {
background: #c0c0c0;
min-width: 30px;
border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
background: #3498db;
}
QScrollBar::handle:horizontal:pressed {
background: #2980b9;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
background: none;
}
/* Status bar styling */
QStatusBar {
background-color: #2c3e50;
color: #ffffff;
padding: 3px 6px;
font-size: 11px;
}
/* QTextBrowser styling for statistics details */
QTextBrowser {
background-color: transparent;
border: none;
font-size: 12px;
font-family: 'Segoe UI', Arial, sans-serif;
color: #495057;
}
</string>
