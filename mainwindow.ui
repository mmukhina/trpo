<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>960</width>
    <height>727</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Синтаксический анализатор</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    /* Global background */
    QMainWindow, QWidget#centralwidget {
        background-color: #e8ecf1;
    }
    
    /* Input frame */
    QFrame#inputFrame {
        background-color: #ffffff;
        border: 1px solid #d0d0d0;
        border-radius: 8px;
    }
    
    /* Text edit styling */
    QTextEdit {
        border: 1px solid #d0d0d0;
        border-radius: 6px;
        padding: 10px;
        font-size: 13px;
        background-color: #fafbfc;
    }
    QTextEdit:focus {
        border-color: #3498db;
        background-color: #ffffff;
    }
    
    /* Button styling */
    QPushButton {
        border-radius: 5px;
        padding: 6px 12px;
    }
    
    QPushButton#btn_search {
        background-color: #3498db;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        padding: 6px 16px;
    }
    QPushButton#btn_search:hover {
        background-color: #2980b9;
    }
    QPushButton#btn_search:pressed {
        background-color: #1f618d;
    }
    QPushButton#btn_search:disabled {
        background-color: #bdc3c7;
    }
    
    QPushButton#btn_upload {
        background-color: #ecf0f1;
        color: #2c3e50;
        border: 1px solid #bdc3c7;
        border-radius: 6px;
        font-size: 13px;
        padding: 6px 16px;
    }
    QPushButton#btn_upload:hover {
        background-color: #dfe6e9;
    }
    QPushButton#btn_upload:pressed {
        background-color: #bdc3c7;
    }
    
    QPushButton#btn_download:enabled {
        background-color: #27ae60;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-size: 13px;
        padding: 6px 16px;
    }
    QPushButton#btn_download:enabled:hover {
        background-color: #219a52;
    }
    QPushButton#btn_download:disabled {
        background-color: #bdc3c7;
        color: #95a5a6;
        border: none;
        border-radius: 6px;
    }
    
    /* Filter frame */
    QFrame#filterFrame {
        background-color: #ffffff;
        border: 1px solid #d0d0d0;
        border-radius: 8px;
    }
    
    QLabel#filterLabel {
        color: #2c3e50;
        font-size: 13px;
        font-weight: bold;
    }
    
    QFrame#filterInnerFrame {
        background-color: #f8fafc;
        border-radius: 6px;
    }
    
    /* Checkbox styling */
    QCheckBox {
        spacing: 8px;
        font-size: 12px;
        color: #2c3e50;
        background-color: transparent;
    }
    QCheckBox::indicator {
        width: 16px;
        height: 16px;
        border-radius: 3px;
        border: 1px solid #bdc3c7;
        background-color: #ffffff;
    }
    QCheckBox::indicator:checked {
        background-color: #3498db;
        border-color: #3498db;
    }
    QCheckBox::indicator:hover {
        border-color: #3498db;
    }
    
    QCheckBox#c_all {
        font-weight: bold;
        color: #3498db;
    }
    QCheckBox#c_all::indicator {
        border-color: #3498db;
    }
    
    /* Tab widget styling */
    QTabWidget::pane {
        background-color: #ffffff;
        border: 1px solid #d0d0d0;
        border-radius: 8px;
    }
    QTabBar::tab {
        background-color: #ecf0f1;
        padding: 8px 20px;
        margin-right: 2px;
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
        font-size: 12px;
        font-weight: 500;
        color: #2c3e50;
    }
    QTabBar::tab:selected {
        background-color: #ffffff;
        color: #3498db;
        border-bottom: 2px solid #3498db;
    }
    QTabBar::tab:hover:!selected {
        background-color: #dfe6e9;
    }
    
    /* Tree widget styling */
    QTreeWidget {
        background-color: #ffffff;
        border: none;
        font-size: 13px;
        outline: 0;
    }
    QTreeWidget::item {
        padding: 6px;
        border-bottom: 1px solid #ecf0f1;
        background-color: #ffffff;
    }
    QTreeWidget::item:hover {
        background-color: #f0f4f8;
    }
    QTreeWidget::item:selected {
        background-color: #3498db;
        color: #ffffff;
    }
    QTreeWidget::item:selected:hover {
        background-color: #2980b9;
    }
    QHeaderView::section {
        background-color: #f8fafc;
        padding: 8px;
        border: none;
        border-bottom: 1px solid #d0d0d0;
        font-weight: 500;
        font-size: 12px;
        color: #2c3e50;
    }
    
    /* Statistics container */
    QWidget#statisticsContainer {
        background-color: #ffffff;
    }
    
    /* Group box styling for statistics */
    QGroupBox {
        background-color: #f8fafc;
        border: 1px solid #d0d0d0;
        border-radius: 8px;
        margin-top: 8px;
        padding-top: 8px;
    }
    QGroupBox::title {
        subcontrol-origin: margin;
        left: 12px;
        padding: 0 6px;
        color: #2c3e50;
        font-weight: 500;
        font-size: 12px;
        background-color: #f8fafc;
    }
    
    /* Label styling for statistics counts */
    QLabel[objectName*=&quot;_count&quot;] {
        color: #3498db;
        font-size: 28px;
        font-weight: bold;
        background-color: transparent;
    }
    
    /* Text browser styling for statistics lists */
    QTextBrowser {
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        background-color: #ffffff;
        font-size: 12px;
        padding: 8px;
    }
    
    /* Scroll area styling */
    QScrollArea#statisticsScrollArea {
        border: none;
        background-color: #ffffff;
    }
    
    /* Scrollbar styling */
    QScrollBar:vertical {
        border: none;
        background: #f0f0f0;
        width: 10px;
        border-radius: 5px;
        margin: 0px;
    }
    QScrollBar::handle:vertical {
        background: #c0c0c0;
        min-height: 30px;
        border-radius: 5px;
    }
    QScrollBar::handle:vertical:hover {
        background: #3498db;
    }
    QScrollBar::handle:vertical:pressed {
        background: #2980b9;
    }
    QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
        height: 0px;
    }
    QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
        background: none;
    }
    
    QScrollBar:horizontal {
        border: none;
        background: #f0f0f0;
        height: 10px;
        border-radius: 5px;
        margin: 0px;
    }
    QScrollBar::handle:horizontal {
        background: #c0c0c0;
        min-width: 30px;
        border-radius: 5px;
    }
    QScrollBar::handle:horizontal:hover {
        background: #3498db;
    }
    QScrollBar::handle:horizontal:pressed {
        background: #2980b9;
    }
    QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
        width: 0px;
    }
    
    /* Specific scrollbar for tree widget */
    QTreeWidget QScrollBar:vertical {
        width: 8px;
        border-radius: 4px;
        background: #f0f0f0;
    }
    QTreeWidget QScrollBar::handle:vertical {
        border-radius: 4px;
        background: #c0c0c0;
    }
    QTreeWidget QScrollBar::handle:vertical:hover {
        background: #3498db;
    }
    
    /* Specific scrollbar for text edit */
    QTextEdit QScrollBar:vertical {
        width: 8px;
        border-radius: 4px;
        background: #f0f0f0;
    }
    QTextEdit QScrollBar::handle:vertical {
        border-radius: 4px;
        background: #c0c0c0;
    }
    QTextEdit QScrollBar::handle:vertical:hover {
        background: #3498db;
    }
    
    /* Specific scrollbar for text browser */
    QTextBrowser QScrollBar:vertical {
        width: 8px;
        border-radius: 4px;
        background: #f0f0f0;
    }
    QTextBrowser QScrollBar::handle:vertical {
        border-radius: 4px;
        background: #c0c0c0;
    }
    QTextBrowser QScrollBar::handle:vertical:hover {
        background: #3498db;
    }
    
    /* Status bar styling */
    QStatusBar {
        background-color: #2c3e50;
        color: #ffffff;
        padding: 4px 8px;
        font-size: 11px;
    }
   </string>
